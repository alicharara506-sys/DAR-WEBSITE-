{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": ["http://localhost/index.html?lang=en", "http://localhost/index.html?lang=ar", "http://localhost/index.html?lang=fr"],
      "numberOfRuns": 1
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    }
  }
}
